{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provoware.local/schemas/mission.schema.json",
  "title": "PPPOPPI Bunkerwahrheit MissionDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "start_phase_id", "phases", "success_effects"],
  "properties": {
    "id": {"type": "string", "pattern": "^mission\\.[a-z0-9_.-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "minLength": 1, "maxLength": 1000},
    "category": {"type": "string", "minLength": 1},
    "repeat_policy": {"type": "string", "enum": ["ONCE_PER_CAMPAIGN", "ONCE_PER_MONTH", "REPEATABLE"]},
    "start_phase_id": {"$ref": "#/$defs/phaseId"},
    "start_requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "start_costs": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset_months"],
      "properties": {
        "offset_months": {"type": "integer", "minimum": 1},
        "partial_success_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "pause_extends_deadline": {"type": "boolean"}
      }
    },
    "pause_on_signals": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/signalId"}},
    "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "success_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "partial_success_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "failure_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "cancel_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "phaseId": {"type": "string", "pattern": "^phase\\.[a-z0-9_.-]+$"},
    "pathId": {"type": "string", "pattern": "^path\\.[a-z0-9_.-]+$"},
    "objectiveId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "signalId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
    "requirement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["resource_minimum", "flag_true", "flag_false", "mission_completed", "mission_status", "month_at_least", "month_before", "current_location", "character_available", "ability_unlocked", "path_selected", "objective_complete"]},
        "resource_id": {"type": "string"}, "amount": {"type": "integer"}, "flag_id": {"type": "string"},
        "mission_id": {"type": "string"}, "status": {"type": "string"}, "month": {"type": "integer", "minimum": 0},
        "location_id": {"type": "string"}, "character_id": {"type": "string"}, "ability_id": {"type": "string"},
        "path_id": {"$ref": "#/$defs/pathId"}, "objective_id": {"$ref": "#/$defs/objectiveId"},
        "target": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "effect": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "resource_id", "amount"], "properties": {"type": {"const": "modify_resource"}, "resource_id": {"type": "string", "pattern": "^resource\\.[a-z0-9_.-]+$"}, "amount": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "flag_id"], "properties": {"type": {"const": "set_flag"}, "flag_id": {"type": "string", "minLength": 1}, "value": {}}}
      ]
    },
    "trigger": {"type": "object", "additionalProperties": false, "required": ["signal"], "properties": {"signal": {"$ref": "#/$defs/signalId"}, "match": {"type": "object"}, "amount": {"type": "integer", "minimum": 1}, "amount_field": {"type": "string", "minLength": 1}}},
    "objective": {"type": "object", "additionalProperties": false, "required": ["id", "title", "target"], "properties": {"id": {"$ref": "#/$defs/objectiveId"}, "title": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "target": {"type": "integer", "minimum": 1}, "path_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/pathId"}}, "trigger": {"$ref": "#/$defs/trigger"}}},
    "path": {"type": "object", "additionalProperties": false, "required": ["id", "title"], "properties": {"id": {"$ref": "#/$defs/pathId"}, "title": {"type": "string", "minLength": 1}, "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}, "selection_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["id", "title", "objectives"], "properties": {"id": {"$ref": "#/$defs/phaseId"}, "title": {"type": "string", "minLength": 1}, "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "objectives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objective"}}, "start_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "completion_effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "next_phase_id": {"oneOf": [{"$ref": "#/$defs/phaseId"}, {"const": ""}]}, "next_phase_by_path": {"type": "object", "additionalProperties": {"$ref": "#/$defs/phaseId"}}}}
  }
}
